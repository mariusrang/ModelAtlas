# Copy this file to `.env` and adjust the values.
#   cp .env.example .env
# `.env` is git-ignored, never commit it.

# ---------- Neo4j ----------
NEO4J_USER=neo4j
# Change this! Neo4j refuses passwords shorter than 8 characters.
NEO4J_PASSWORD=change-me-please
# Inside docker compose the API reaches Neo4j by its service name.
# When running the API on your machine (`make run`), use bolt://localhost:7687
NEO4J_URI=bolt://neo4j:7687
NEO4J_DATABASE=neo4j
# Memory for Neo4j (we have 32 GB laptops; keep room for Ollama)
NEO4J_HEAP_SIZE=4G
NEO4J_PAGECACHE_SIZE=6G

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Key required on admin endpoints (X-API-Key header). Generate your own, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-too

# ---------- LLM (local, no paid key needed) ----------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
# Model used for text-to-Cypher and answers (pulled by `make ollama-pull`)
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=120

# ---------- UI ----------
# The Streamlit app calls the API through this URL (service name inside compose)
API_BASE_URL=http://api:8000

# ---------- Data ----------
# full = whole scoped dump (needs ~1.5 GB download), sample = small fixture in tests/fixtures
SEED_MODE=sample
HF_TOKEN=
# Where the big raw downloads go (default: ./data inside the repo).
# On Windows, keep it OUTSIDE OneDrive so 1.5 GB isn't uploaded to the cloud:
# MODELATLAS_DATA_DIR=C:\modelatlas-data
